<Window x:Class="WindowsMssqlStudio.ConnectionDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Connect to Server" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
    <TextBlock Text="Sunucu" VerticalAlignment="Center" Margin="0,4"/><TextBox x:Name="ServerBox" Grid.Column="1" Text="localhost" Margin="4"/>
    <TextBlock Text="Kimlik doğrulama" Grid.Row="1" VerticalAlignment="Center" Margin="0,4"/><ComboBox x:Name="AuthBox" Grid.Row="1" Grid.Column="1" SelectedIndex="0" Margin="4" SelectionChanged="AuthBox_SelectionChanged"><ComboBoxItem>Windows Authentication</ComboBoxItem><ComboBoxItem>SQL Server Authentication</ComboBoxItem></ComboBox>
    <TextBlock Text="Kullanıcı" Grid.Row="2" VerticalAlignment="Center" Margin="0,4"/><TextBox x:Name="UserBox" Grid.Row="2" Grid.Column="1" Margin="4"/>
    <TextBlock Text="Parola" Grid.Row="3" VerticalAlignment="Center" Margin="0,4"/><PasswordBox x:Name="PasswordBox" Grid.Row="3" Grid.Column="1" Margin="4"/>
    <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,4"><Button Content="Sunucuya bağlan" Click="LoadDatabases_Click"/><TextBlock x:Name="ServerStatus" VerticalAlignment="Center" Margin="8,0" Foreground="#52606D" /></StackPanel>
    <TextBlock Text="Veritabanı" Grid.Row="5" VerticalAlignment="Center" Margin="0,4"/><ComboBox x:Name="DatabaseBox" Grid.Row="5" Grid.Column="1" Margin="4" IsEnabled="False" />
    <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="İptal" IsCancel="True"/><Button Content="Bağlan" IsDefault="True" Click="Connect_Click"/></StackPanel>
  </Grid>
</Window>
