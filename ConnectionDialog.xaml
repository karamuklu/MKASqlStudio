<Window x:Class="WindowsMssqlStudio.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQL Server bağlantısı" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F4F7FB" FontFamily="Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#172033" />
    <SolidColorBrush x:Key="Muted" Color="#667085" />
    <SolidColorBrush x:Key="Line" Color="#DCE4EF" />
    <Style TargetType="TextBox"><Setter Property="Height" Value="36" /><Setter Property="Padding" Value="10,7" /><Setter Property="Foreground" Value="{StaticResource Ink}" /><Setter Property="BorderBrush" Value="{StaticResource Line}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style TargetType="PasswordBox"><Setter Property="Height" Value="36" /><Setter Property="Padding" Value="10,7" /><Setter Property="Foreground" Value="{StaticResource Ink}" /><Setter Property="BorderBrush" Value="{StaticResource Line}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style TargetType="ComboBox"><Setter Property="Height" Value="36" /><Setter Property="Padding" Value="8,5" /><Setter Property="Foreground" Value="{StaticResource Ink}" /><Setter Property="BorderBrush" Value="{StaticResource Line}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style TargetType="Button"><Setter Property="Margin" Value="4,0,0,0" /><Setter Property="Padding" Value="16,8" /><Setter Property="Foreground" Value="#344054" /><Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#D8E0EC" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Cursor" Value="Hand" /></Style>
  </Window.Resources>
  <Border Margin="14" Background="#FFFFFF" BorderBrush="#DCE4EF" BorderThickness="1" CornerRadius="12">
    <Grid Margin="24">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Margin="0,0,0,20"><TextBlock Text="SQL Server bağlantısı" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Ink}" /><TextBlock Text="Sunucuya bağlanın, ardından çalışacağınız veritabanını seçin." Margin="0,5,0,0" Foreground="{StaticResource Muted}" FontSize="12" /></StackPanel>
      <TextBlock Grid.Row="1" Text="Kayıtlı bağlantı" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6" />
      <ComboBox x:Name="SavedConnectionsBox" Grid.Row="2" DisplayMemberPath="DisplayName" SelectionChanged="SavedConnectionsBox_SelectionChanged" />
      <Grid Grid.Row="3" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Sunucu" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6" /><TextBox x:Name="ServerBox" Text="localhost" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Kimlik doğrulama" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6" /><ComboBox x:Name="AuthBox" SelectedIndex="0" SelectionChanged="AuthBox_SelectionChanged"><ComboBoxItem>Windows Authentication</ComboBoxItem><ComboBoxItem>SQL Server Authentication</ComboBoxItem></ComboBox></StackPanel></Grid>
      <Grid Grid.Row="4" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Kullanıcı" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6" /><TextBox x:Name="UserBox" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Parola" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6" /><PasswordBox x:Name="PasswordBox" /></StackPanel></Grid>
      <Border Grid.Row="5" Background="#F5F8FC" BorderBrush="#E5EAF2" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Veritabanı" Foreground="{StaticResource Ink}" FontWeight="SemiBold" /><TextBlock Text="Sunucu bağlantısından sonra seçebilirsiniz" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" /></StackPanel><ComboBox x:Name="DatabaseBox" Grid.Column="1" Width="220" IsEnabled="False" /></Grid></Border>
      <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Sunucuya bağlan" Click="LoadDatabases_Click" Background="#EAF2FF" Foreground="#1D4ED8" BorderBrush="#B9D0FA" /><TextBlock x:Name="ServerStatus" VerticalAlignment="Center" Margin="9,0,0,0" Foreground="{StaticResource Muted}" /></StackPanel>
      <Border Grid.Row="7" BorderBrush="#E5EAF2" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,16,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="İptal" IsCancel="True" /><Button Content="Bağlan" IsDefault="True" Click="Connect_Click" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" /></StackPanel></Border>
    </Grid>
  </Border>
</Window>

