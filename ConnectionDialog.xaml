<Window x:Class="WindowsMssqlStudio.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQL Server bağlantısı" Width="900" Height="650" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F3F6FA" FontFamily="Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#172033" /><SolidColorBrush x:Key="Muted" Color="#667085" /><SolidColorBrush x:Key="Line" Color="#D8E0EC" />
    <Style TargetType="TextBox"><Setter Property="Height" Value="36" /><Setter Property="Padding" Value="10,7" /><Setter Property="Foreground" Value="{StaticResource Ink}" /><Setter Property="BorderBrush" Value="{StaticResource Line}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style TargetType="PasswordBox"><Setter Property="Height" Value="36" /><Setter Property="Padding" Value="10,7" /><Setter Property="Foreground" Value="{StaticResource Ink}" /><Setter Property="BorderBrush" Value="{StaticResource Line}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style TargetType="ComboBox"><Setter Property="Height" Value="36" /><Setter Property="Padding" Value="8,5" /><Setter Property="Foreground" Value="{StaticResource Ink}" /><Setter Property="BorderBrush" Value="{StaticResource Line}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style TargetType="Button"><Setter Property="Margin" Value="4,0,0,0" /><Setter Property="Padding" Value="16,8" /><Setter Property="Foreground" Value="#344054" /><Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#D8E0EC" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="18,10" /><Setter Property="Foreground" Value="#475467" /></Style>
  </Window.Resources>
  <Border Margin="14" Background="#FFFFFF" BorderBrush="#DCE4EF" BorderThickness="1" CornerRadius="12">
    <Grid Margin="28">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid Grid.Row="0" Grid.ColumnSpan="4" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SQL Server bağlantısı" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Ink}" /><TextBlock Text="Sunucuya bağlan, kimlik doğrulamayı seç ve çalışacağın veritabanını belirle." Margin="0,5,0,0" Foreground="{StaticResource Muted}" FontSize="12" /></StackPanel><Border Grid.Column="1" Background="#EEF4FF" BorderBrush="#C7DBFF" BorderThickness="1" CornerRadius="8" Padding="12,8" VerticalAlignment="Center"><StackPanel><TextBlock Text="MICROSOFT SQL SERVER" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8" /><TextBlock Text="Yeni veri kaynağı" FontSize="11" Foreground="#52606D" Margin="0,2,0,0" /></StackPanel></Border></Grid>
      <TextBlock Grid.Row="1" Grid.Column="0" Text="Ad" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,10,10" /><TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Margin="0,0,16,10" /><TextBlock Grid.Row="1" Grid.Column="2" Text="Kayıtlı bağlantı" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,10,10" /><ComboBox x:Name="SavedConnectionsBox" Grid.Row="1" Grid.Column="3" DisplayMemberPath="DisplayName" SelectionChanged="SavedConnectionsBox_SelectionChanged" Margin="0,0,0,10" />
      <TextBlock Grid.Row="2" Grid.Column="0" Text="Açıklama" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,10,10" /><TextBox x:Name="CommentBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,10" />
      <Border Grid.Row="3" Grid.ColumnSpan="4" BorderBrush="#D8E0EC" BorderThickness="0,0,0,1" Margin="0,2,0,12" />
      <TabControl Grid.Row="4" Grid.ColumnSpan="4" Margin="0,0,0,16" SelectedIndex="0">
        <TabItem Header="Genel"><Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Sunucu" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,10,10" /><TextBox x:Name="HostBox" Grid.Row="0" Grid.Column="1" Margin="0,0,12,10" Text="localhost" /><TextBlock Grid.Row="0" Grid.Column="2" Text="Port" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,10,10" /><TextBox x:Name="PortBox" Grid.Row="0" Grid.Column="3" Margin="0,0,0,10" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Instance" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,10,10" /><TextBox x:Name="InstanceBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,10" />
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Kimlik doğrulama" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,10,10" /><ComboBox x:Name="AuthBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" SelectedIndex="0" SelectionChanged="AuthBox_SelectionChanged" Margin="0,0,0,10"><ComboBoxItem>Windows Authentication</ComboBoxItem><ComboBoxItem>User &amp; Password</ComboBoxItem></ComboBox>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="Kullanıcı" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,10,0" /><TextBox x:Name="UserBox" Grid.Row="3" Grid.Column="1" Margin="0,0,12,0" /><TextBlock Grid.Row="3" Grid.Column="2" Text="Parola" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,10,0" /><PasswordBox x:Name="PasswordBox" Grid.Row="3" Grid.Column="3" />
        </Grid></TabItem>
        <TabItem Header="Seçenekler"><TextBlock Text="Şema ve gelişmiş bağlantı seçenekleri sonraki sürümde burada yönetilecek." Foreground="{StaticResource Muted}" Margin="12" /></TabItem><TabItem Header="SSH/SSL"><TextBlock Text="SQL Server bağlantısı için TLS ayarları bağlantı dizesinden yönetilir." Foreground="{StaticResource Muted}" Margin="12" /></TabItem><TabItem Header="Şemalar"><TextBlock Text="Bağlandıktan sonra veritabanı ve şema seçimi Object Explorer üzerinden yapılır." Foreground="{StaticResource Muted}" Margin="12" /></TabItem><TabItem Header="Gelişmiş"><TextBlock Text="Daha fazla bağlantı seçeneği yakında eklenecek." Foreground="{StaticResource Muted}" Margin="12" /></TabItem>
      </TabControl>
      <Border Grid.Row="5" Grid.ColumnSpan="4" Background="#F7F9FC" BorderBrush="#DCE4EF" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Çalışma veritabanı" Foreground="{StaticResource Ink}" FontWeight="SemiBold" /><TextBlock Text="Sunucuya bağlandıktan sonra sorguların çalışacağı veritabanını seç." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" /></StackPanel><ComboBox x:Name="DatabaseBox" Grid.Column="1" IsEnabled="False" /></Grid></Border>
      <StackPanel Grid.Row="6" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16"><Button Content="Sunucuya bağlan" Click="LoadDatabases_Click" Background="#EAF2FF" Foreground="#1D4ED8" BorderBrush="#B9D0FA" /><TextBlock x:Name="ServerStatus" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource Muted}" /></StackPanel>
      <Border Grid.Row="7" Grid.ColumnSpan="4" BorderBrush="#E5EAF2" BorderThickness="0,1,0,0" Padding="0,16,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="İptal" IsCancel="True" /><Button Content="Bağlan" IsDefault="True" Click="Connect_Click" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" /></StackPanel></Border>
    </Grid>
  </Border>
</Window>

