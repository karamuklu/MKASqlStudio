<Window x:Class="WindowsMssqlStudio.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQL Server bağlantısı" Width="980" Height="700" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F3F6FA" FontFamily="Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#172033" /><SolidColorBrush x:Key="Muted" Color="#667085" />
    <Style TargetType="TextBox"><Setter Property="Height" Value="40" /><Setter Property="Padding" Value="12,9" /><Setter Property="Foreground" Value="#172033" /><Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#C7D2E3" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style TargetType="PasswordBox"><Setter Property="Height" Value="40" /><Setter Property="Padding" Value="12,9" /><Setter Property="Foreground" Value="#172033" /><Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#C7D2E3" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style TargetType="ComboBox"><Setter Property="Height" Value="40" /><Setter Property="Padding" Value="10,7" /><Setter Property="Foreground" Value="#172033" /><Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#C7D2E3" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style TargetType="Button"><Setter Property="Height" Value="40" /><Setter Property="Padding" Value="16,8" /><Setter Property="Margin" Value="4,0,0,0" /><Setter Property="Foreground" Value="#344054" /><Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#D8E0EC" /><Setter Property="BorderThickness" Value="1" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" /></Style>
  </Window.Resources>
  <Border Margin="14" Background="#FFFFFF" BorderBrush="#DCE4EF" BorderThickness="1" CornerRadius="16">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="92" /><RowDefinition Height="*" /><RowDefinition Height="76" /></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#101C35" CornerRadius="16,16,0,0" Padding="24,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="46" Height="46" Background="#2563EB" CornerRadius="12" Margin="0,0,14,0"><TextBlock Text="M" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="SQL Server bağlantısı" Foreground="White" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="Sunucunu seç, bağlantıyı doğrula ve çalışma veritabanını belirle" Foreground="#AFC0DD" FontSize="12" Margin="0,4,0,0" /></StackPanel><Border Grid.Column="2" Background="#1D3158" BorderBrush="#38527D" BorderThickness="1" CornerRadius="9" Padding="12,8" VerticalAlignment="Center"><StackPanel><TextBlock Text="MICROSOFT SQL SERVER" FontSize="10" FontWeight="Bold" Foreground="#9FC2FF" /><TextBlock Text="Yeni veri kaynağı" FontSize="11" Foreground="#D7E4F8" Margin="0,2,0,0" /></StackPanel></Border></Grid></Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="270" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,16,16"><StackPanel><TextBlock Text="Bağlantı profili" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" /><TextBlock Text="Bu bağlantıyı daha sonra hızlıca kullanmak için ad ve açıklama gir." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,14" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Profil adı" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5" /><TextBox x:Name="NameBox" /></StackPanel><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Açıklama" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5" /><TextBox x:Name="CommentBox" /></StackPanel></Grid></StackPanel></Border>
        <Border Grid.Column="1" Background="#F7F9FC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16"><StackPanel><TextBlock Text="Kayıtlı bağlantılar" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" /><TextBlock Text="Daha önce kaydettiğin profili seç." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,12" /><ComboBox x:Name="SavedConnectionsBox" DisplayMemberPath="DisplayName" SelectionChanged="SavedConnectionsBox_SelectionChanged" /></StackPanel></Border>
        <Border Grid.Row="1" Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,16,0"><StackPanel><TextBlock Text="Sunucu ayarları" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" /><TextBlock Text="SQL Server adresi ve kimlik doğrulama bilgileri." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,14" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,10"><TextBlock Text="Sunucu" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5" /><TextBox x:Name="HostBox" Text="localhost" /></StackPanel><StackPanel Grid.Column="1" Margin="10,0,0,10"><TextBlock Text="Port" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5" /><TextBox x:Name="PortBox" /></StackPanel><StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10"><TextBlock Text="Instance" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5" /><TextBox x:Name="InstanceBox" /></StackPanel><StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,10"><TextBlock Text="Kimlik doğrulama" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5" /><ComboBox x:Name="AuthBox" SelectedIndex="0" SelectionChanged="AuthBox_SelectionChanged"><ComboBoxItem>Windows Authentication</ComboBoxItem><ComboBoxItem>User &amp; Password</ComboBoxItem></ComboBox></StackPanel><StackPanel Grid.Row="3" Margin="0,0,10,0"><TextBlock Text="Kullanıcı" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5" /><TextBox x:Name="UserBox" /></StackPanel><StackPanel Grid.Row="3" Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Parola" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5" /><PasswordBox x:Name="PasswordBox" /></StackPanel></Grid></StackPanel></Border>
        <StackPanel Grid.Row="1" Grid.Column="1"><Border Background="#F7F9FC" BorderBrush="#DCE4EF" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12"><StackPanel><TextBlock Text="Çalışma veritabanı" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" /><TextBlock Text="Sunucu doğrulandıktan sonra seçebilirsin." FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,12" /><ComboBox x:Name="DatabaseBox" IsEnabled="False" /></StackPanel></Border><Button Content="Sunucuyu bağla" Click="LoadDatabases_Click" Background="#EEF4FF" Foreground="#1D4ED8" BorderBrush="#B9D0FA" HorizontalAlignment="Stretch" /><TextBlock x:Name="ServerStatus" Text="Bağlantı bekleniyor" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="4,8,4,0" /></StackPanel>
      </Grid></ScrollViewer>
      <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E5EAF2" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16" Padding="24,14"><DockPanel LastChildFill="False"><TextBlock Text="Bağlantı profili yerel olarak kaydedilir." Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" /><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="İptal" IsCancel="True" /><Button Content="Bağlan" IsDefault="True" Click="Connect_Click" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" MinWidth="100" /></StackPanel></DockPanel></Border>
    </Grid>
  </Border>
</Window>

