<Window x:Class="WindowsMssqlStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MKA SQL Studio" Height="850" Width="1400"
        MinHeight="650" MinWidth="1050" Background="#F3F4F6">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#C7CBD1" />
    </Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#1F4E78" Padding="10,7">
      <DockPanel>
        <TextBlock Text="MKA SQL Studio" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock x:Name="TopConnectionText" Text="  Bağlantı yok" Foreground="#D7E8F7" Margin="18,0,0,0" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <Menu DockPanel.Dock="Top" Background="#FFFFFF">
      <MenuItem Header="Dosya">
        <MenuItem Header="Yeni sorgu" Click="NewQuery_Click" />
        <Separator />
        <MenuItem Header="Çıkış" Click="Exit_Click" />
      </MenuItem>
      <MenuItem Header="Bağlantı">
        <MenuItem Header="Bağlan / Bağlantıyı değiştir" Click="Connect_Click" />
        <MenuItem Header="Şemayı yenile" Click="RefreshSchema_Click" />
      </MenuItem>
      <MenuItem Header="Sorgu">
        <MenuItem Header="Çalıştır (F5)" Click="Execute_Click" />
        <MenuItem Header="Durdur" Click="Cancel_Click" />
      </MenuItem>
    </Menu>
    <ToolBar DockPanel.Dock="Top" Background="#E8EAED">
      <Button Content="Yeni sorgu" Click="NewQuery_Click" />
      <Button Content="Aç" IsEnabled="False" />
      <Button Content="Kaydet" IsEnabled="False" />
      <Separator />
      <Button Content="Bağlan" Click="Connect_Click" />
      <Button Content="Bağlantıyı kes" Click="Disconnect_Click" />
      <Button Content="Şemayı yenile" Click="RefreshSchema_Click" />
      <Separator />
      <Button Content="▶ Çalıştır" Click="Execute_Click" Background="#DFF1E5" />
      <Button Content="■ Durdur" Click="Cancel_Click" />
      <TextBlock Text="  F5 çalıştır · Ctrl+F5 seçili sorgu" VerticalAlignment="Center" Foreground="#52606D" Margin="8,0" />
    </ToolBar>
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem><TextBlock x:Name="StatusText" Text="Bağlı değil" /></StatusBarItem>
      <Separator />
      <StatusBarItem><TextBlock x:Name="TimingText" /></StatusBarItem>
    </StatusBar>
    <Grid>
      <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#C7CBD1" BorderThickness="0,0,1,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#E8EAED" BorderBrush="#D2D6DB" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel><TextBlock Text="Object Explorer" FontWeight="SemiBold" /><Button DockPanel.Dock="Right" Content="⟳" ToolTip="Yenile" Click="RefreshSchema_Click" Padding="7,2" /></DockPanel>
          </Border>
          <Border DockPanel.Dock="Top" Background="#F7F8FA" Padding="10,8" BorderBrush="#E0E3E7" BorderThickness="0,0,0,1">
            <TextBlock x:Name="ConnectionLabel" Text="Bağlantı yok" Foreground="#52606D" TextWrapping="Wrap" />
          </Border>
          <TreeView x:Name="SchemaTree" Margin="8,0,8,8" />
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E1E6EF" />
      <Grid Grid.Column="2" Margin="10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="230" />
          <RowDefinition Height="5" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TabControl x:Name="QueryTabs" Grid.Row="0" Margin="0,0,0,8" Background="#FFFFFF">
          <TabItem Header="SQLQuery1.sql" />
        </TabControl>
        <Border Grid.Row="1" BorderBrush="#C7CBD1" BorderThickness="1" Background="#FFFFFF">
        <TextBox x:Name="SqlEditor" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="14"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                 Padding="10" Text="SELECT TOP (100) name, type_desc&#x0a;FROM sys.objects&#x0a;ORDER BY name;" KeyDown="SqlEditor_KeyDown" />
        </Border>
        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="#E1E6EF" />
        <TabControl Grid.Row="3">
          <TabItem Header="Results"><DataGrid x:Name="ResultsGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal" /></TabItem>
          <TabItem Header="Mesajlar"><TextBox x:Name="MessagesBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" /></TabItem>
        </TabControl>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
