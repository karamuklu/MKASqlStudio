<Window x:Class="WindowsMssqlStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MKA SQL Studio" Height="900" Width="1480"
        MinHeight="680" MinWidth="1100" Background="#F4F7FB"
        FontFamily="Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#172033" />
    <SolidColorBrush x:Key="Muted" Color="#718096" />
    <SolidColorBrush x:Key="Line" Color="#DCE4EF" />
    <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
    <Style TargetType="Button">
      <Setter Property="Margin" Value="2" /><Setter Property="Padding" Value="12,7" /><Setter Property="Foreground" Value="#344054" /><Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#D8E0EC" /><Setter Property="BorderThickness" Value="1" /><Setter Property="FontSize" Value="12" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EEF4FF" /><Setter Property="BorderBrush" Value="#AFC7F7" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="{StaticResource Ink}" /><Setter Property="BorderBrush" Value="{StaticResource Line}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="9,7" /></Style>
    <Style TargetType="TreeViewItem"><Setter Property="Padding" Value="4,5" /><Setter Property="Foreground" Value="#344054" /><Setter Property="FontSize" Value="12" /></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="14,8" /><Setter Property="Foreground" Value="#667085" /></Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#111C33" Padding="18,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Background="#2563EB" CornerRadius="7" Padding="9,6" Margin="0,0,11,0"><TextBlock Text="M" Foreground="White" FontWeight="Bold" FontSize="16" /></Border><StackPanel><TextBlock Text="MKA SQL Studio" Foreground="White" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="VersionText" Text="v0.3.0 · SQL Server çalışma alanı" Foreground="#9DB2D2" FontSize="10" /></StackPanel></StackPanel><TextBlock Grid.Column="1" x:Name="TopConnectionText" Text="  Bağlantı yok" Foreground="#B6C6DF" VerticalAlignment="Center" Margin="30,0,0,0" /><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="Güncelle" Click="CheckForUpdates_Click" Background="#1E3154" Foreground="White" BorderBrush="#38527D" /><Button Content="Hakkında" Click="About_Click" Background="Transparent" Foreground="#C9D6EB" BorderBrush="#38527D" /></StackPanel></Grid></Border>
    <Menu DockPanel.Dock="Top" Background="#FFFFFF" Foreground="#475467" Padding="8,2"><MenuItem Header="Dosya"><MenuItem Header="Yeni sorgu" Click="NewQuery_Click" /><Separator /><MenuItem Header="Çıkış" Click="Exit_Click" /></MenuItem><MenuItem Header="Bağlantı"><MenuItem Header="Bağlan / Bağlantıyı değiştir" Click="Connect_Click" /><MenuItem Header="Şemayı yenile" Click="RefreshSchema_Click" /></MenuItem><MenuItem Header="Sorgu"><MenuItem Header="Çalıştır (F5)" Click="Execute_Click" /><MenuItem Header="Durdur" Click="Cancel_Click" /></MenuItem></Menu>
    <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E5EAF2" BorderThickness="0,1,0,1" Padding="13,8"><StackPanel Orientation="Horizontal"><Button Content="＋ Yeni sorgu" Click="NewQuery_Click" /><Button Content="Bağlan" Click="Connect_Click" Background="#EAF2FF" Foreground="#1D4ED8" BorderBrush="#B9D0FA" /><Button Content="Bağlantıyı kes" Click="Disconnect_Click" /><ComboBox x:Name="DatabaseSelector" Width="190" Margin="8,0,0,0" IsEnabled="False" ToolTip="Çalışılacak veritabanını seçin" SelectionChanged="DatabaseSelector_SelectionChanged" /><Button Content="⟳ Şemayı yenile" Click="RefreshSchema_Click" /><Separator Width="12" Margin="8,0" /><Button Content="▶  Çalıştır" Click="Execute_Click" Background="#16A34A" Foreground="White" BorderBrush="#16A34A" /><Button Content="■  Durdur" Click="Cancel_Click" /><TextBlock Text="F5 çalıştır · Ctrl+Space önerileri aç" VerticalAlignment="Center" Foreground="#98A2B3" Margin="14,0,0,0" FontSize="11" /></StackPanel></Border>
    <StatusBar DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#E5EAF2" BorderThickness="0,1,0,0" Padding="8,3"><StatusBarItem><TextBlock x:Name="StatusText" Text="Bağlı değil" Foreground="#667085" /></StatusBarItem><Separator /><StatusBarItem><TextBlock x:Name="TimingText" Foreground="#98A2B3" /></StatusBarItem><StatusBarItem HorizontalAlignment="Right"><TextBlock x:Name="FooterVersionText" Text="MKA SQL Studio · Windows · v0.3.0" Foreground="#98A2B3" /></StatusBarItem></StatusBar>
    <Grid Margin="12,10,12,8"><Grid.ColumnDefinitions><ColumnDefinition Width="285" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9"><DockPanel><Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E7EDF5" BorderThickness="0,0,0,1" CornerRadius="9,9,0,0" Padding="13,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="OBJECT EXPLORER" FontSize="10" FontWeight="Bold" Foreground="#667085" /><TextBlock Text="Veritabanı nesneleri" FontSize="13" FontWeight="SemiBold" Foreground="#172033" Margin="0,3,0,0" /></StackPanel><Button Grid.Column="1" Content="⟳" ToolTip="Şemayı yenile" Click="RefreshSchema_Click" Padding="7,3" HorizontalAlignment="Right" /></Grid></Border><Border DockPanel.Dock="Top" Background="#F8FAFC" Padding="12,10" BorderBrush="#E7EDF5" BorderThickness="0,0,0,1"><TextBlock x:Name="ConnectionLabel" Text="Bağlantı yok" Foreground="#667085" TextWrapping="Wrap" FontSize="11" /></Border><TextBox x:Name="ExplorerFilter" DockPanel.Dock="Top" Margin="10" Padding="9,7" ToolTip="Nesnelerde ara" TextChanged="ExplorerFilter_TextChanged" /><TreeView x:Name="SchemaTree" Margin="7,0,7,8" BorderThickness="0" /></DockPanel></Border>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Center" Width="4" Background="#DCE4EF" />
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="7" /><RowDefinition Height="270" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#DCE4EF" BorderThickness="1,1,1,0" CornerRadius="9,9,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TabControl x:Name="QueryTabs" SelectionChanged="QueryTabs_SelectionChanged" BorderThickness="0" Background="Transparent"><TabItem Header="●  SQLQuery1.sql" /></TabControl><TextBlock Grid.Column="1" Text="Ctrl+Space  IntelliSense" Foreground="#98A2B3" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0" /></Grid></Border>
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D0D7E2" BorderThickness="1,0,1,1" CornerRadius="0,0,9,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="#F3F6FA"><TextBlock x:Name="LineNumbers" Text="1" Foreground="#7B8798" FontFamily="Consolas" FontSize="13" TextAlignment="Right" Padding="0,14,11,0" VerticalAlignment="Top" /></Border><RichTextBox Grid.Column="1" x:Name="SqlEditor" AcceptsTab="True" FontFamily="Cascadia Code,Consolas" FontSize="14" Foreground="#1F2937" Background="#FFFFFF" BorderThickness="0" CaretBrush="#2563EB" SelectionBrush="#BFDBFE" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12,14" KeyDown="SqlEditor_KeyDown" TextChanged="SqlEditor_TextChanged" PreviewKeyDown="SqlEditor_PreviewKeyDown" /><Popup x:Name="IntelliSensePopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"><Border Background="#FFFFFF" BorderBrush="#C9D7EA" BorderThickness="1" CornerRadius="7" Width="330" MaxHeight="280" Padding="4"><ListBox x:Name="IntelliSenseList" BorderThickness="0" DisplayMemberPath="Display" /></Border></Popup></Grid></Border>
        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="#DCE4EF" /><Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#DCE4EF" BorderThickness="1" CornerRadius="9"><TabControl BorderThickness="0"><TabItem Header="Results"><DataGrid x:Name="ResultsGrid" AutoGenerateColumns="True" AutoGeneratingColumn="ResultsGrid_AutoGeneratingColumn" IsReadOnly="True" CanUserSortColumns="True" CanUserResizeColumns="True" CanUserReorderColumns="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC" BorderThickness="0" ColumnHeaderHeight="58" /></TabItem><TabItem Header="Mesajlar"><TextBox x:Name="MessagesBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="14" BorderThickness="0" /></TabItem></TabControl></Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>

